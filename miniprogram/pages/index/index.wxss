.container { padding: 24rpx; background: #f5f6fa; min-height: 100vh; }
.section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 20rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.add-btn { font-size: 28rpx; color: #1a5276; }
.domain-grid { display: flex; gap: 24rpx; }
.domain-card { flex: 1; padding: 40rpx 24rpx; border-radius: 16rpx; text-align: center; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); border: 2rpx solid transparent; }
.domain-card.disabled { opacity: 0.5; background: #f5f5f5; }
.domain-card.enabled { border-color: #e0e0e0; }
.domain-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.domain-name { font-size: 28rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 8rpx; }
.domain-desc { font-size: 22rpx; color: #888; }
.case-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.case-title { font-size: 30rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 12rpx; }
.case-meta { display: flex; justify-content: space-between; font-size: 24rpx; color: #888; }
.case-domain { padding: 4rpx 12rpx; border-radius: 8rpx; background: #f0f0f0; }
.case-status { padding: 4rpx 12rpx; border-radius: 8rpx; }
.case-status.COLLECTING { background: #fff3e0; color: #e65100; }
.case-status.ANALYZING { background: #e3f2fd; color: #1565c0; }
.case-status.READY { background: #e8f5e9; color: #2e7d32; }
.empty-hint { text-align: center; color: #999; padding: 40rpx; font-size: 28rpx; }
.loading { text-align: center; color: #999; padding: 20rpx; }
.tips { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.tip-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.tip-item { font-size: 24rpx; color: #666; line-height: 1.8; }
