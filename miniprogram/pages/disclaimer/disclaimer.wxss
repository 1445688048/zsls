.container { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #f5f6fa; padding: 40rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 40rpx; width: 100%; max-width: 680rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08); }
.title { font-size: 40rpx; font-weight: bold; color: #1a5276; text-align: center; margin-bottom: 32rpx; }
.content { font-size: 26rpx; color: #333; line-height: 1.8; margin-bottom: 40rpx; max-height: 500rpx; overflow-y: auto; }
.content h4 { font-size: 28rpx; font-weight: bold; margin: 20rpx 0 8rpx; color: #1a1a1a; }
.buttons { display: flex; gap: 24rpx; }
.btn-agree { flex: 1; background: #1a5276; color: #fff; border-radius: 12rpx; padding: 24rpx; font-size: 30rpx; text-align: center; }
.btn-disagree { flex: 1; background: #fff; color: #999; border: 2rpx solid #ddd; border-radius: 12rpx; padding: 24rpx; font-size: 30rpx; text-align: center; }
