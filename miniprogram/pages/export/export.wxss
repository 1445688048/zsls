.container { padding: 24rpx; background: #f5f6fa; min-height: 100vh; }
.case-info { background: #1a5276; color: #fff; padding: 40rpx 28rpx; border-radius: 0 0 24rpx 24rpx; margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; }
.subtitle { font-size: 26rpx; opacity: 0.8; }
.section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.option-card { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.option-card:last-child { border-bottom: none; }
.option-icon { font-size: 40rpx; margin-right: 20rpx; }
.option-content { flex: 1; }
.option-name { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 4rpx; }
.option-desc { font-size: 24rpx; color: #888; }
.option-arrow { font-size: 32rpx; color: #ccc; }
.tip { font-size: 24rpx; color: #666; line-height: 1.8; padding: 8rpx 0; }
