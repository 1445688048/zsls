.container { padding: 24rpx; background: #f5f6fa; min-height: 100vh; }
.header { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; background: #fff; margin-bottom: 24rpx; border-radius: 16rpx; }
.title { font-size: 32rpx; font-weight: bold; }
.add-btn { background: #1a5276; color: #fff; border-radius: 8rpx; padding: 12rpx 24rpx; font-size: 26rpx; }
.timeline { position: relative; padding-left: 40rpx; }
.timeline::before { content: ""; position: absolute; left: 16rpx; top: 0; bottom: 0; width: 4rpx; background: #e0e0e0; }
.timeline-item { position: relative; padding: 20rpx 0; }
.dot { position: absolute; left: -32rpx; top: 28rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #1a5276; }
.timeline-item.deadline .dot { background: #e74c3c; }
.timeline-content { background: #fff; border-radius: 12rpx; padding: 20rpx; }
.event-time { font-size: 24rpx; color: #888; margin-bottom: 8rpx; }
.event-desc { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.deadline .event-desc { color: #e74c3c; font-weight: bold; }
.event-meta { display: flex; gap: 12rpx; align-items: center; }
.event-type { font-size: 22rpx; color: #666; background: #f0f0f0; padding: 4rpx 12rpx; border-radius: 4rpx; }
.deadline-badge { font-size: 22rpx; color: #fff; background: #e74c3c; padding: 4rpx 12rpx; border-radius: 4rpx; }
.reminder { font-size: 24rpx; color: #e67e22; margin-top: 8rpx; }
.event-actions { margin-top: 12rpx; }
.delete-btn { font-size: 24rpx; color: #e74c3c; }
.empty { text-align: center; color: #999; padding: 60rpx 0; }
.loading { text-align: center; color: #999; padding: 40rpx; }
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999; }
.modal-content { background: #fff; border-radius: 20rpx; padding: 40rpx; width: 85%; max-height: 80vh; overflow-y: auto; }
.modal-title { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; text-align: center; }
.form-group { margin-bottom: 20rpx; }
.label { font-size: 26rpx; color: #333; margin-bottom: 8rpx; }
.input, .textarea { width: 100%; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; font-size: 26rpx; box-sizing: border-box; }
.textarea { min-height: 100rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-cancel { flex: 1; background: #f5f5f5; color: #666; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
.btn-save { flex: 1; background: #1a5276; color: #fff; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
