.container { padding: 24rpx; background: #f5f6fa; min-height: 100vh; }
.section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.evidence-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.evidence-item:last-child { border-bottom: none; }
.evidence-info { flex: 1; }
.evidence-name { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 4rpx; }
.evidence-desc { font-size: 24rpx; color: #888; }
.evidence-status { font-size: 24rpx; padding: 8rpx 16rpx; border-radius: 8rpx; }
.evidence-status.collected { background: #d4edda; color: #155724; }
.evidence-status.pending { background: #f8d7da; color: #721c24; }
.evidence-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.evidence-card { width: calc(33.33% - 16rpx); aspect-ratio: 1; position: relative; border-radius: 8rpx; overflow: hidden; }
.evidence-img { width: 100%; height: 100%; object-fit: cover; }
.evidence-delete { position: absolute; top: 8rpx; right: 8rpx; width: 36rpx; height: 36rpx; background: rgba(0,0,0,0.5); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20rpx; }
.evidence-add { width: calc(33.33% - 16rpx); aspect-ratio: 1; border: 2rpx dashed #ccc; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.add-icon { font-size: 48rpx; color: #ccc; }
.add-text { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.empty { text-align: center; color: #999; padding: 40rpx; }
.tip { font-size: 24rpx; color: #888; text-align: center; margin-top: 20rpx; }
