.container { padding: 24rpx; background: #f5f6fa; min-height: 100vh; }
.header { display: flex; align-items: center; padding: 20rpx 0; background: #fff; margin-bottom: 24rpx; }
.back-btn { font-size: 28rpx; color: #1a5276; margin-right: 20rpx; }
.title { font-size: 32rpx; font-weight: bold; flex: 1; text-align: center; }
.section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.domain-grid { display: flex; gap: 20rpx; }
.domain-card { flex: 1; padding: 32rpx 20rpx; border-radius: 12rpx; border: 2rpx solid #e0e0e0; text-align: center; position: relative; }
.domain-card.selected { border-color: #1a5276; background: #e8f4fd; }
.domain-icon { font-size: 48rpx; margin-bottom: 12rpx; }
.domain-name { font-size: 26rpx; font-weight: bold; color: #333; }
.domain-desc { font-size: 20rpx; color: #888; margin-top: 8rpx; }
.selected-check { position: absolute; top: 12rpx; right: 12rpx; color: #1a5276; font-size: 24rpx; font-weight: bold; }
.input { width: 100%; border: 2rpx solid #e0e0e0; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.textarea { width: 100%; border: 2rpx solid #e0e0e0; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; min-height: 150rpx; box-sizing: border-box; }
.btn-create { background: #1a5276; color: #fff; border-radius: 12rpx; padding: 24rpx; font-size: 30rpx; margin-top: 32rpx; }
.tip { text-align: center; font-size: 24rpx; color: #888; margin-top: 24rpx; }
