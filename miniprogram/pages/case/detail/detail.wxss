.container { padding: 24rpx; background: #f5f6fa; min-height: 100vh; }
.case-header { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.case-title { font-size: 32rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 12rpx; }
.case-meta { display: flex; gap: 16rpx; }
.domain-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: #e8f4fd; color: #1a5276; }
.status-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.status-COLLECTING { background: #fff3e0; color: #e65100; }
.status-ANALYZING { background: #e3f2fd; color: #1565c0; }
.status-READY { background: #e8f5e9; color: #2e7d32; }
.tab-bar { background: #fff; border-radius: 12rpx; padding: 16rpx; margin-bottom: 24rpx; }
.tab-scroll { white-space: nowrap; }
.tab-list { display: inline-flex; gap: 8rpx; }
.tab-item { padding: 16rpx 24rpx; font-size: 26rpx; color: #666; border-radius: 8rpx; }
.tab-item.active { background: #1a5276; color: #fff; }
.tab-content { background: #fff; border-radius: 16rpx; padding: 28rpx; min-height: 300rpx; }
.chat-hint, .law-hint, .timeline-hint, .evidence-hint { text-align: center; color: #888; padding: 40rpx 0; }
.btn-chat, .btn-evidence, .btn-timeline { background: #1a5276; color: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 20rpx; }
.fact-item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.fact-label { font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
.fact-value { font-size: 28rpx; color: #333; }
.fact-low { color: #e74c3c; }
.law-item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.law-item:last-child { border-bottom: none; }
.law-title { font-size: 28rpx; font-weight: bold; color: #1a5276; margin-bottom: 8rpx; }
.law-content { font-size: 26rpx; color: #444; line-height: 1.7; }
.empty { text-align: center; color: #999; padding: 40rpx; }
.disclaimer { background: #fff3cd; color: #856404; padding: 20rpx; border-radius: 8rpx; font-size: 24rpx; margin-top: 20rpx; }
.refresh-btn { position: fixed; bottom: 100rpx; right: 40rpx; width: 80rpx; height: 80rpx; background: #1a5276; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2); }
