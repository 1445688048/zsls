/* app.wxss - 全局样式 */
page { background-color: #f5f6fa; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.container { padding: 24rpx; }
.section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.section-title { font-size: 32rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 20rpx; }
.btn-primary { background: #1a5276; color: #fff; border-radius: 8rpx; padding: 20rpx 40rpx; text-align: center; font-size: 30rpx; }
.btn-secondary { background: #fff; color: #1a5276; border: 2rpx solid #1a5276; border-radius: 8rpx; padding: 18rpx 40rpx; text-align: center; font-size: 30rpx; }
.text-muted { color: #999; font-size: 24rpx; }
